{
  "name": "dsh-plugin-evo-harness",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "DeepSeek Harness (Cordis) plugin: reversible eight-surface Harness² editing, Dream-RSI online search / offline replay, and a governed Universal MCP memory bridge.",
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --outfile=lib/index.js --sourcemap=external --log-level=warning",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "check:docs": "node scripts/verify-readme-counts.mjs",
    "bench:jitrl": "node scripts/bench-jitrl-query.mjs",
    "eval:jitrl": "node scripts/eval-jitrl.mjs",
    "eval:build": "node scripts/eval/build-eval.mjs",
    "eval:jitrl:baseline": "node scripts/eval-jitrl.mjs --baseline docs/reports/p6-eval-baseline.md",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
