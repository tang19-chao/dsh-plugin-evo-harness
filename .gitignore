# dependencies
node_modules/

# team runtime state (never publish)
.agent-teams/

# local scratch and upstream verification artifacts
work/
outputs/
%SystemDrive%/

# extracted upstream probe copies and one-off asar/verification scripts
dsh-probe/
bridge-verify/
f1-repro/
asar-*.cjs

# build and test output
#
# NOTE (PR-1): these are ANCHORED with a leading slash on purpose. The old
# `lib/` pattern matched ANY directory named `lib` at any depth, which silently
# excluded `scripts/eval/lib/` - the canonical git-object evidence module
# (`git-objects.mjs`) that PR-1 requires to be committed. A build artifact is
# `/lib/` at the repository root; a nested library directory is source.
/lib/
/dist/
/coverage/
*.tsbuildinfo

# logs and local env
*.log
.env
.env.*

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
